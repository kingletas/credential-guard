#!/usr/bin/env bash
#
# credential-guard -- keep credentials out of git, in any repository here.
#
# Usage:
#   credential-guard scan [path ...]     scan a working tree (default: .)
#   credential-guard history [path]      scan every blob in a repo's history
#   credential-guard install [path]      vendor the hook into a repo and wire it
#   credential-guard watch [--notify]    scan the files that must never hold one
#   credential-guard self-test           check the scanner against its own cases
#
# Environment overrides:
#   GUARD_SCANNER   path to check_credentials.py (default: this tool's .d dir)
#   GUARD_WATCHLIST paths `watch` scans, one per line
#                   (default: ~/.config/credential-guard/watchlist)
#
# Exit status:
#   0   every file was opened and nothing looked like a credential
#   1   something looked like a credential, or there was nothing to scan
#   2   the target does not exist, not one file could be opened, or the
#       scanner could not be run
#
# A scan that opened no file exits non-zero on purpose. Silence from a security
# check has to mean "looked, found nothing"; anything else trains the reader to
# take a green tick as an answer when no question was asked.
#
# Why `install` *copies* the scanner into a repository rather than referencing
# the one on PATH: a pre-commit hook has to run for everyone who clones the repo,
# and a contributor does not have your PATH. So this tool owns the canonical
# copy and `install` vendors it; re-running `install` updates the vendored copy
# in place. One owner, and a copy for people who clone.
#
# `history` exists because the working tree is the half that is easy to check.
# **A key removed in a later commit is still in the repository, and is still
# published by a push.** This is not hypothetical: one project here shipped a
# first commit holding ten environment fallbacks with real values in them, and
# nothing in a working-tree scan would ever have said so.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Two layouts, because this tool lives in two places. Installed on PATH it keeps
# its parts in a sibling `<name>.d/` directory; checked out of its repository the
# scanner sits beside it in `bin/`. Probing for the file rather than assuming one
# layout is what lets `./bin/credential-guard` work straight out of a clone --
# and a tool you cannot run from a fresh clone is a tool nobody evaluates.
if [[ -n "${GUARD_SCANNER:-}" ]]; then
  SCANNER="$GUARD_SCANNER"
elif [[ -f "$HERE/credential-guard.d/check_credentials.py" ]]; then
  SCANNER="$HERE/credential-guard.d/check_credentials.py"
else
  SCANNER="$HERE/check_credentials.py"
fi

usage() { sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

[[ "${1:-}" =~ ^(-h|--help|help)$ || $# -eq 0 ]] && { usage; exit 0; }

[[ -f "$SCANNER" ]] || {
  echo "credential-guard: scanner not found at $SCANNER; nothing was checked" >&2; exit 2; }

# Scans the NUL-separated paths on stdin, which has no length limit. Any exit
# status the scanner does not define means it never ran, not that it found one.
scan_paths() {
  local rc=0
  python3 "$SCANNER" --files0-from - || rc=$?
  case "$rc" in
    0|1|2) return "$rc" ;;
  esac
  echo "credential-guard: the scanner could not be run (exit $rc). NOTHING WAS CHECKED." >&2
  return 2
}

cmd="$1"; shift

case "$cmd" in
  self-test)
    exec python3 "$SCANNER" --self-test
    ;;

  scan)
    # Several arguments, or one that is a file, means scan exactly those. The
    # directory form walks a whole tree, which is right for a repository sweep
    # and wrong for a pre-commit hook, which hands it the staged files; a hook
    # that re-scans a large tree on every commit gets uninstalled. One argument
    # that is a directory walks that directory.
    if [[ $# -gt 1 || ( $# -eq 1 && -f "$1" ) ]]; then
      echo "credential-guard: scanning $# file(s)"
      scan_paths < <(printf '%s\0' "$@")
      exit
    fi
    target="${1:-.}"
    # A target that is not there cannot be scanned, and saying so beats walking
    # an empty result set and reporting a clean tree.
    [[ -e "$target" ]] || {
      echo "credential-guard: $target does not exist; nothing was scanned" >&2; exit 2; }
    if root="$(git -C "$target" rev-parse --show-toplevel 2>/dev/null)"; then
      # Tracked files only: an untracked build directory is not going anywhere.
      #
      # `--full-name` prints every path relative to the repository root, so the
      # root is what they are joined onto. Joining them onto $target instead
      # doubles the prefix whenever $target is a subdirectory of the repository,
      # and every file is then handed to the scanner under a path that is not
      # there.
      #
      # `-z`, because plain `ls-files` prints a C-quoted rendering of any path
      # carrying a byte outside ASCII rather than the path itself, and every
      # such name would then be handed to the scanner as a file that is not
      # there. A file the scanner cannot open is a file it cannot clear, and it
      # has no way to say so.
      mapfile -d "" -t files < <(git -C "$target" ls-files -z --full-name \
        | while IFS= read -r -d "" f; do printf '%s\0' "$root/$f"; done)
    else
      mapfile -d "" -t files < <(find "$target" -type f -not -path '*/.git/*' -print0)
    fi
    # Nothing to scan is a failure, never a pass. A credential scanner that
    # exits 0 having opened no file prints a green tick over an unexamined
    # tree, and the next person reads that as cleared.
    [[ ${#files[@]} -eq 0 ]] && {
      echo "credential-guard: no files to scan in $target; nothing was checked" >&2; exit 1; }
    echo "credential-guard: scanning ${#files[@]} file(s) in $target"
    scan_paths < <(printf '%s\0' "${files[@]}")
    exit
    ;;

  watch)
    # `scan` covers a repository, which is where a commit can carry a credential
    # away. `watch` covers everything that is in NO repository -- a shell
    # profile, a git config, an alias file -- which is exactly where nothing was
    # ever looking. Two credentials survived years here for that reason: a
    # production private key beside a .pfx, and a shell profile carrying two AWS
    # key pairs and eight other secrets, world-readable and sourced by both
    # shells.
    #
    # THE LIST HOLDS FILES THAT MUST NOT CONTAIN A CREDENTIAL, and that is what
    # keeps this quiet enough to be worth running. A designated store -- an
    # ~/.aws/credentials, a password file, an encrypted archive -- is not on it,
    # because those hold credentials on purpose and listing them would make this
    # fire every single run. A check that can never be silent is not a check,
    # and the fastest way to lose one is to make it cry wolf weekly.
    notify=0
    if [[ "${1:-}" == "--notify" ]]; then notify=1; fi
    list="${GUARD_WATCHLIST:-$HOME/.config/credential-guard/watchlist}"
    [[ -f "$list" ]] || { echo "credential-guard: no watchlist at $list" >&2; exit 2; }

    declare -a targets=() absent=() excludes=()
    # A line starting with ! is an exclusion glob, matched against the full
    # path. Build products are the case that matters: a virtualenv under a
    # tool's own .d directory holds a 24MB linter binary, the scanner refuses
    # anything that large, and refusing to scan counts as a failure -- rightly,
    # since silence has to mean "looked". Without a way to exclude, the check
    # fires forever on a file nobody wrote.
    while IFS= read -r line; do
      line="${line%%#*}"; line="${line#"${line%%[![:space:]]*}"}"
      line="${line%"${line##*[![:space:]]}"}"
      # `[[ ... ]] && cmd` as a whole statement returns non-zero when the test
      # is false, and under `set -e` that ends the script. Same trap as the
      # command substitution below, twice in one verb.
      if [[ "$line" == !* ]]; then excludes+=("${line#!}"); fi
    done < "$list"

    excluded() {
      local path="$1" pat
      for pat in "${excludes[@]}"; do
        # shellcheck disable=SC2053  # the right-hand side is a glob on purpose
        if [[ "$path" == $pat ]]; then return 0; fi
      done
      return 1
    }

    while IFS= read -r line; do
      line="${line%%#*}"; line="${line#"${line%%[![:space:]]*}"}"
      line="${line%"${line##*[![:space:]]}"}"
      [[ -n "$line" ]] || continue
      if [[ "$line" == !* ]]; then continue; fi
      line="${line/#\~/$HOME}"; line="${line/#\$HOME/$HOME}"
      # A glob that matches nothing must not silently become zero work.
      declare -a hits=()
      for h in $line; do if [[ -e "$h" ]]; then hits+=("$h"); fi; done
      if [[ ${#hits[@]} -eq 0 ]]; then absent+=("$line"); continue; fi
      # A directory is walked only when it was named. A glob contributes the
      # files it matched and nothing below them: `~/.[!.]*` is how you say
      # "every dotfile at the top of my home directory", and walking the dot
      # directories it also matches means scanning ~/.cache and ~/.local --
      # hundreds of thousands of files, and a check that times out.
      from_glob=0
      if [[ "$line" == *[*?\[]* ]]; then from_glob=1; fi
      for h in "${hits[@]}"; do
        if [[ -d "$h" && $from_glob -eq 1 ]]; then
          continue
        elif [[ -d "$h" ]]; then
          while IFS= read -r -d "" f; do
            excluded "$f" || targets+=("$f")
          done < <(find "$h" -type f -not -path '*/.git/*' -print0)
        else
          excluded "$h" || targets+=("$h")
        fi
      done
    done < "$list"

    # A listed path that is gone is REPORTED, never skipped. Skipping is how a
    # watchlist stops watching anything without saying so.
    if [[ ${#absent[@]} -gt 0 ]]; then
      printf 'credential-guard: listed but not on disk:\n' >&2
      printf '  %s\n' "${absent[@]}" >&2
      printf '  edit %s -- a path that moved is not a path that is clean\n' "$list" >&2
    fi
    if [[ ${#targets[@]} -eq 0 ]]; then
      echo "credential-guard: the watchlist matched no file; nothing was checked" >&2; exit 1
    fi

    # `set -e` is on, and a command substitution that fails takes the whole
    # script with it -- silently, before a single line of the report is
    # printed. Every other verb ends in `exec`, so none of them ever met this.
    # A check whose own failure path exits 0 bytes is the failure it exists to
    # prevent, wearing its own badge.
    #
    # xargs rather than one exec, because a watchlist that names a large
    # directory blows past ARG_MAX. Handing 35,541 paths to the scanner in one
    # call failed with "Argument list too long" -- and the wrapper reported
    # that as a credential. **A scanner that could not run must never be
    # reported as a scanner that found something**, which is why xargs' own
    # 126/127 are separated out below rather than folded into "finding".
    argfile="$(mktemp)"
    printf '%s\0' "${targets[@]}" > "$argfile"
    if out="$(xargs -0 -a "$argfile" python3 "$SCANNER" 2>&1)"; then rc=0; else rc=$?; fi
    rm -f "$argfile"
    if [[ $rc -eq 126 || $rc -eq 127 ]]; then
      printf '%s\n' "$out" >&2
      printf 'credential-guard: the scanner could not be run. NOTHING WAS CHECKED.\n' >&2
      exit 2
    fi
    if [[ $rc -eq 0 && ${#absent[@]} -eq 0 ]]; then exit 0; fi
    if [[ $rc -ne 0 ]]; then
      printf '%s\n' "$out" >&2
      printf 'credential-guard: a credential is sitting in a file that should not hold one.\n' >&2
      printf '  %d file(s) checked, from %s\n' "${#targets[@]}" "$list" >&2
      if [[ $notify -eq 1 ]] && command -v notify-send >/dev/null 2>&1; then
        # Critical urgency on purpose: do-not-disturb is the normal state here,
        # and an alert that respects it is an alert nobody receives.
        notify-send -u critical "credential-guard" \
          "A credential is in a file that should not hold one. Run: credential-guard watch"
      fi
    fi
    exit 1
    ;;

  history)
    target="${1:-.}"
    root="$(git -C "$target" rev-parse --show-toplevel)"
    # Every blob ever committed, not just the ones reachable from the tip.
    echo "credential-guard: scanning every blob in $root"
    tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

    # Name each blob after a path it was committed under, so a finding says
    # "app/config/services.py" rather than a hash nobody can act on. A blob
    # reachable under several names gets whichever git lists first; a blob that
    # was never named -- reachable only from a dangling object -- keeps its hash.
    declare -A seen=()
    while read -r sha path; do
      [[ -n "${path:-}" && -z "${seen[$sha]:-}" ]] && seen[$sha]="$path"
    done < <(git -C "$root" rev-list --objects --all 2>/dev/null)

    n=0
    while read -r sha; do
      name="${seen[$sha]:-orphan-blob-$sha}"
      dest="$tmp/$name"
      mkdir -p "$(dirname "$dest")"
      git -C "$root" cat-file blob "$sha" > "$dest" 2>/dev/null || continue
      n=$((n + 1))
    done < <(git -C "$root" cat-file --batch-all-objects --batch-check='%(objectname) %(objecttype)' \
             | awk '$2=="blob"{print $1}')
    echo "credential-guard: $n blob(s)"

    # Paths are reconstructed above, so filename rules fire here too -- which is
    # the point: a .env or a .db committed once and deleted later is still in the
    # history and still published by a push.
    mapfile -t blobs < <(find "$tmp" -type f)
    python3 "$SCANNER" "${blobs[@]}" | sed "s|$tmp/||" || exit 1
    echo "credential-guard: history clean"
    ;;

  install)
    target="${1:-.}"
    root="$(git -C "$target" rev-parse --show-toplevel)"
    mkdir -p "$root/scripts"
    cp "$SCANNER" "$root/scripts/check_credentials.py"
    chmod +x "$root/scripts/check_credentials.py"
    echo "credential-guard: vendored scripts/check_credentials.py into $root"

    cfg="$root/.pre-commit-config.yaml"
    if [[ -f "$cfg" ]] && grep -q "check-credentials" "$cfg"; then
      echo "credential-guard: pre-commit hook already wired; scanner updated in place"
    elif [[ -f "$cfg" ]]; then
      echo "credential-guard: add this to $cfg under a 'repo: local' block:"
      printf '\n      - id: check-credentials\n        name: check for committed credentials\n        entry: python3 scripts/check_credentials.py\n        language: system\n        pass_filenames: true\n        exclude: ^scripts/check_credentials\\.py$\n\n'
    else
      # No pre-commit framework here: fall back to a plain git hook, which needs
      # no dependency at all and works in a repo that has never seen Python.
      hook="$root/.git/hooks/pre-commit"
      if [[ -e "$hook" ]]; then
        echo "credential-guard: $hook exists; not overwriting. Add this line to it:"
        echo '  git diff --cached --name-only -z --diff-filter=ACM | xargs -0 -r python3 scripts/check_credentials.py'
      else
        cat > "$hook" <<'HOOK'
#!/usr/bin/env bash
# Installed by credential-guard. Refuses staged changes that look like secrets.
set -euo pipefail
# -z / xargs -0: without them git C-quotes any non-ASCII path and xargs splits
# the rest on spaces, so the files most in need of scanning are the ones the
# scanner never opens -- and it exits 0 either way. Straight down the pipe,
# never through a variable, because bash drops NUL bytes in a command
# substitution. `xargs -r` covers the nothing-staged case.
git diff --cached --name-only -z --diff-filter=ACM \
  | xargs -0 -r python3 "$(git rev-parse --show-toplevel)/scripts/check_credentials.py"
HOOK
        chmod +x "$hook"
        echo "credential-guard: installed .git/hooks/pre-commit"
      fi
    fi
    ;;

  *)
    echo "credential-guard: unknown command '$cmd'" >&2
    usage >&2
    exit 2
    ;;
esac
